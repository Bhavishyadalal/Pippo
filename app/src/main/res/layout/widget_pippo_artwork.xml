<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/art_widget_root" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/art_widget_background" android:layout_width="match_parent"
        android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/widget_background"
        android:importantForAccessibility="no" />
    <LinearLayout android:id="@+id/art_widget_controls" android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:paddingStart="14dp" android:paddingEnd="14dp"
        android:paddingTop="10dp" android:paddingBottom="10dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingStart="4dp" android:paddingEnd="4dp">
                <TextView android:id="@+id/art_widget_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:ellipsize="end" android:maxLines="1" android:text="@string/no_song_playing"
                    android:textColor="#FFF9F6" android:textSize="14sp" android:textStyle="bold" />
                <TextView android:id="@+id/art_widget_artist" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:ellipsize="end" android:maxLines="1" android:text="@string/tap_to_open"
                    android:textColor="#EBDFE4" android:textSize="11sp" />
            </LinearLayout>
            <ImageView android:id="@+id/art_widget_like" android:layout_width="42dp" android:layout_height="42dp"
                android:background="@drawable/widget_pippo_art_button" android:padding="10dp"
                android:src="@drawable/ic_widget_heart_outline_nav" android:tint="#FFF9F6"
                android:contentDescription="@string/widget_art_like" />
        </LinearLayout>
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:paddingStart="5dp" android:paddingEnd="5dp">
            <TextView android:id="@+id/art_widget_elapsed" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:maxLines="1" android:textColor="#EBDFE4" android:textSize="10sp" />
            <TextView android:id="@+id/art_widget_remaining" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:maxLines="1" android:textColor="#EBDFE4" android:textSize="10sp" />
        </LinearLayout>
        <ProgressBar android:id="@+id/art_widget_progress" style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginBottom="5dp"
            android:layout_marginStart="5dp" android:layout_marginEnd="5dp"
            android:progressTint="#FFF1E9" android:progressBackgroundTint="#80FFF1E9"
            android:indeterminate="false" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center">
            <ImageView android:id="@+id/art_widget_previous" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="48dp" android:layout_marginHorizontal="2dp" android:background="@drawable/widget_pippo_art_button"
                android:scaleType="centerInside" android:padding="10dp" android:src="@drawable/ic_widget_skip_previous"
                android:tint="#FFF9F6" android:contentDescription="@string/immersive_previous" />
            <ImageView android:id="@+id/art_widget_toggle" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="48dp" android:layout_marginHorizontal="2dp" android:background="@drawable/widget_pippo_art_button"
                android:scaleType="centerInside" android:padding="10dp" android:src="@drawable/ic_widget_play_secondary"
                android:tint="#FFF9F6" android:contentDescription="@string/play" />
            <ImageView android:id="@+id/art_widget_next" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="48dp" android:layout_marginHorizontal="2dp" android:background="@drawable/widget_pippo_art_button"
                android:scaleType="centerInside" android:padding="10dp" android:src="@drawable/ic_widget_skip_next"
                android:tint="#FFF9F6" android:contentDescription="@string/immersive_next" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
